# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ADMIN_JWT_SECRET: Optional secret key for signing admin authentication tokens.
ADMIN_JWT_SECRET=

# ADMIN_PIN: Optional custom PIN for admin dashboard access.
ADMIN_PIN=

# SUPABASE: Supabase URL and Publishable Client Key for durable cloud data persistence.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
