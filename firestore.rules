rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.role == 'admin' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Platform data storage - allows public read & write for app_data collections
    match /app_data/{document=**} {
      allow read, write: if true;
    }

    // Public settings, courses & config
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student Specific Documents
    match /students/{studentId} {
      allow read, write: if isOwner(studentId) || isAdmin();
      
      match /progress/{lessonId} {
        allow read, write: if isOwner(studentId) || isAdmin();
      }
      
      match /attempts/{attemptId} {
        allow read, write: if isOwner(studentId) || isAdmin();
      }

      match /weakness_profile/{profileId} {
        allow read, write: if isOwner(studentId) || isAdmin();
      }
    }

    // Admin Documents
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default Deny All other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

